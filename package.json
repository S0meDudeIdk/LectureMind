{
  "name": "lecturemind",
  "private": true,
  "version": "1.0.0",
  "description": "LectureMind — AI-Powered Audio-to-Mindmap Generator",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "lint": "oxlint"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.2",
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.21.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@uiw/react-codemirror": "^4.25.11",
    "busboy": "^1.6.0",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "katex": "^0.18.4",
    "marked": "^18.0.10",
    "markmap-lib": "^0.18.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-mind-map": "^0.14.0-fix.3",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.5": true
  }
}
