{
  "name": "lecturemind",
  "private": true,
  "version": "1.0.0",
  "description": "LectureMind â€” AI-Powered Audio-to-Mindmap Generator",
  "type": "module",
  "engines": {
    "node": "24.x",
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server/server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server/server.cjs",
    "start": "node server.ts",
    "preview": "node server.ts --production",
    "lint": "oxlint",
    "typecheck:server": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --esModuleInterop --skipLibCheck server.ts",
    "test": "node --test tests/contracts.test.mjs tests/audio-extractor.test.mjs tests/persistence*.test.mjs && npm run test:backend",
    "test:rules": "firebase emulators:exec --project demo-lecturemind --only firestore,storage \"node --test tests/backend.rules.test.mjs\"",
    "test:app": "node tests/app.browser.mjs",
    "test:backend": "esbuild tests/backend.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/backend.test.mjs && node --test .tmp/backend.test.mjs",
    "test:browser": "node tests/frontend.browser.mjs",
    "test:export": "node tests/mindmap-export.browser.mjs",
    "test:export:production": "node tests/run-export-production.mjs",
    "test:production": "node tests/production.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.27.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@uiw/react-codemirror": "^4.25.12",
    "busboy": "^1.6.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "katex": "^0.18.11",
    "marked": "^18.0.14",
    "markmap-lib": "^0.18.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-mind-map": "^0.14.0-fix.3",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.32.1",
    "oxlint": "^1.86.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "basic-ftp": "^6.2.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.5": true,
    "@google/genai@2.21.0": true,
    "esbuild@0.28.2": true
  }
}
