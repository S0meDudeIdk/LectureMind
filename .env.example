VITE_BACKEND_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional: dedicated GCS bucket for anonymous user uploads (server-side temp staging)
GCS_ANONYMOUS_BUCKET=

# Optional: path to Google Cloud service account key JSON (used when gcloud CLI is not installed)
# In local development, ./service-account-key.json in the project root is auto-detected.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatively, provide raw JSON or base64-encoded service account key (useful for GitHub Secrets, Cloud Run, Docker)
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VITE_RECAPTCHA_SITE_KEY=
VITE_APP_CHECK_PROVIDER=enterprise
# Local development only: use true to print a browser-generated token, then
# register it under Firebase App Check > Apps > Manage debug tokens.
# Production builds ignore this setting; keep actual debug tokens private.
VITE_APP_CHECK_DEBUG_TOKEN=

# Backend production requirements (never expose through VITE_ variables)
# In production, set this to your deployed app's exact origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
QUOTA_HASH_SECRET=
GUEST_DAILY_LIMIT=5
MEMBER_DAILY_LIMIT=50
VERTEX_MODELS=gemini-3.8-flash
# Set only after verifying the deployed reverse-proxy topology.
TRUST_PROXY_HOPS=
