# Firebase (get from Firebase Console → Project Settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=lecturemind-airiser
VITE_FIREBASE_STORAGE_BUCKET=lecturemind-airiser.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini API (get from Google AI Studio)
VITE_GEMINI_API_KEY=

# Cloud Run Backend URL (set after deployment)
VITE_BACKEND_URL=http://localhost:8080

# App Check (reCAPTCHA Enterprise)
VITE_RECAPTCHA_SITE_KEY=
