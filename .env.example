GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional: dedicated GCS bucket for anonymous user uploads (server-side temp staging)
GCS_ANONYMOUS_BUCKET=

# Optional: path to Google Cloud service account key JSON (used when gcloud CLI is not installed)
# In local development, ./service-account-key.json in the project root is auto-detected.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatively, provide raw JSON or base64-encoded service account key (useful for GitHub Secrets, Cloud Run, Docker)
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VITE_RECAPTCHA_SITE_KEY=