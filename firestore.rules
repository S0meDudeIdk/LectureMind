rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function validRecord(id) {
      let data = request.resource.data;
      return data.id == id && data.ownerUid == request.auth.uid
        && data.revision is int && data.revision >= 1
        && data.deleted is bool
        && data.title is string && data.title.size() <= 500
        && data.markdown is string && data.markdown.size() <= 400000
        && data.notes is string && data.notes.size() <= 400000
        && data.transcript is list && data.transcript.size() <= 5000
        && data.createdAt is string && data.updatedAt is string;
    }
    match /mindmaps/{id} {
      // New UUIDs are read before creation inside the client's sync transaction.
      // Only a single-document get may probe absence; list queries still require ownership.
      allow get: if member() && (!exists(/databases/$(database)/documents/mindmaps/$(id))
        || resource.data.ownerUid == request.auth.uid);
      allow list: if member() && resource.data.ownerUid == request.auth.uid;
      allow create: if member() && validRecord(id);
      allow update: if member() && resource.data.ownerUid == request.auth.uid
        && validRecord(id) && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      // Deletion is a revisioned tombstone; physical deletion would permit stale resurrection.
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
